---
import type { CollectionEntry } from 'astro:content';
import Field from './Field.astro';
import { fmtDate } from '../lib/content';
interface Props { entry: CollectionEntry<'videos'>; }
const { entry } = Astro.props;
const { title, date, youtubeId, duration, palette } = entry.data;
---
<a href={`/videos/${entry.id}`} class="vt">
  <div class="frame">
    <Field seed={entry.id} palette={palette} />
    {youtubeId
      ? <img src={`https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`} alt="" loading="lazy" />
      : <div class="glass ui"><div class="play">▶</div><div class="g-title">{title}</div></div>}
    {duration && <span class="dur">{duration}</span>}
  </div>
  <div class="cap"><h3>{title}</h3><p>{fmtDate(date)}</p></div>
</a>
<style>
  .vt { display: block; }
  .frame { position: relative; aspect-ratio: 4/3; border-radius: 22px; }
  img { position: absolute; inset: 10%; width: 80%; height: 80%; object-fit: cover; border-radius: 12px; }
  .ui { position: absolute; left: 14%; right: 14%; bottom: 14%; }
  .play { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: #111; font-size: 10px; padding-left: 2px; margin-bottom: 30px; }
  .dur { position: absolute; top: 14%; right: 14%; font: 400 10.5px var(--mono); color: #fff; opacity: .85; }
  .frame :global(.field) { transition: transform .9s var(--ease); }
  .vt:hover .frame :global(.field) { transform: scale(1.02); }
  .cap { display: flex; justify-content: space-between; gap: 16px; margin-top: 18px; }
  h3 { font-size: 15px; letter-spacing: -0.02em; } .cap p { font-size: 12.5px; color: var(--ink-2); white-space: nowrap; }
</style>
