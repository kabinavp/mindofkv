---
import type { CollectionEntry } from 'astro:content';
import { fmtDate, readingTime } from '../lib/content';
interface Props { entry: CollectionEntry<'articles'>; }
const { entry } = Astro.props;
const { title, description, date, topics } = entry.data;
---
<a href={`/articles/${entry.id}`} class="card">
  <p class="meta"><span>{fmtDate(date)}</span><span>·</span><span>{readingTime(entry.body)} min read</span></p>
  <h3>{title}</h3>
  <p class="desc">{description}</p>
  {topics.length > 0 && <p class="topics">{topics.slice(0, 3).map((t) => <span>#{t}</span>)}</p>}
</a>
<style>
  .card { display: flex; flex-direction: column; gap: 10px; padding: 24px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); text-decoration: none; transition: border-color .15s, transform .15s; }
  .card:hover { border-color: var(--ink); transform: translateY(-2px); }
  .meta { display: flex; gap: 6px; font-size: 0.82rem; color: var(--ink-3); }
  .desc { color: var(--ink-2); font-size: 0.97rem; flex: 1; }
  .topics { display: flex; gap: 10px; font: 500 0.75rem var(--mono); color: var(--accent); }
</style>
