---
import { SITE } from '../site.config';
interface Props { tone?: 'light' | 'dark'; id?: string; }
const { tone = 'light', id = 'sub' } = Astro.props;
const n = SITE.newsletter;
---
<form action={n.action} method="post" target="_blank" class:list={['sub', tone]}>
  <label for={id} class="sr">Email address</label>
  <input id={id} type="email" name={n.emailField} placeholder="Email address" required autocomplete="email" />
  <button type="submit" class="btn">Subscribe</button>
</form>
<style>
  .sub { display: flex; gap: 6px; width: 100%; max-width: 380px; }
  input {
    flex: 1; min-width: 0; height: 30px; padding: 0 11px; border-radius: 4px; border: 0; outline: none;
    background: var(--bg-2); color: var(--ink); font: 400 13px var(--sans); transition: box-shadow .2s;
  }
  input::placeholder { color: var(--ink-3); }
  input:focus { box-shadow: inset 0 0 0 1px var(--ink); }
  .dark input { background: #262625; color: #f2f2ef; } .dark input::placeholder { color: #6f6f6b; }
  .dark input:focus { box-shadow: inset 0 0 0 1px #8d8d88; }
  .dark .btn { background: #f2f2ef; color: var(--dark); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
