---
import type { CollectionEntry } from 'astro:content';
import { paletteFor } from '../lib/palette';
interface Props { entry: CollectionEntry<'products'>; }
const { entry } = Astro.props;
const { title, tagline, status, url, stack, metric, metricLabel, started, palette } = entry.data;
const { colors } = paletteFor(entry.id, palette);
const label = { live: 'Live', building: 'Building', idea: 'Idea', retired: 'Retired' }[status];
---
<article class="cell" style={`--g1:${colors[1]};--g2:${colors[0]}`}>
  <div class="glow" aria-hidden="true"></div>
  <header><h3>{title}</h3><span class:list={['status', status]}>{label}</span></header>
  <div class="foot">
    <p class="stat">{metric ?? label}</p>
    <p class="ml">{metricLabel ?? `since ${started.getFullYear()}`}</p>
    <p class="tag grey">{tagline}</p>
    <p class="meta">{stack.join(' · ')}{stack.length > 0 && ' — '}since {started.getFullYear()}{url && <> — <a href={url} target="_blank" rel="noopener" class="arrow-link">Visit <span>↗</span></a></>}</p>
  </div>
</article>
<style>
  .cell { position: relative; scroll-snap-align: start; border-left: 1px solid var(--line); padding: 0 8px; height: 480px; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; }
  .glow { position: absolute; right: -6%; top: 0; bottom: 0; width: 38%; pointer-events: none;
    background: radial-gradient(40% 50% at 70% 50%, var(--g1), transparent 75%), radial-gradient(22% 42% at 82% 50%, var(--g2), transparent 80%);
    filter: blur(22px); opacity: .9; transition: transform 1.2s var(--ease), opacity .6s; }
  .cell:hover .glow { transform: translateX(-4%); opacity: 1; }
  header { position: relative; display: flex; flex-direction: column; gap: 10px; }
  h3 { font: 500 20px/1 var(--sans); letter-spacing: -0.045em; color: var(--ink-2); }
  .foot { position: relative; max-width: 62%; padding-bottom: 8px; }
  .ml { font-size: 13px; margin-top: 8px; }
  .tag { font-size: 12.5px; line-height: 1.45; margin-top: 18px; }
  .meta { font-size: 11.5px; color: var(--ink-3); margin-top: 10px; }
  .meta a { color: var(--ink); }
  @media (max-width: 760px) { .cell { height: 420px; } .foot { max-width: 80%; } }
</style>
