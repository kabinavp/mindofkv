---
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'products'>; }
const { entry } = Astro.props;
const { title, tagline, status, url, stack, metric, started } = entry.data;
const label = { live: 'Live', building: 'Building', idea: 'Idea', retired: 'Retired' }[status];
---
<article class="card">
  <header>
    <span class:list={['status', status]}><i></i>{label}</span>
    <span class="year">since {started.getFullYear()}</span>
  </header>
  <h3>{title}</h3>
  <p class="tag">{tagline}</p>
  {metric && <p class="metric">{metric}</p>}
  {stack.length > 0 && <p class="stack">{stack.map((s) => <span class="pill">{s}</span>)}</p>}
  {url && <a href={url} class="link-arrow" target="_blank" rel="noopener">Visit</a>}
</article>
<style>
  .card { display: flex; flex-direction: column; gap: 12px; padding: 24px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  header { display: flex; justify-content: space-between; align-items: center; }
  .status { display: inline-flex; align-items: center; gap: 7px; font: 500 0.75rem var(--mono); text-transform: uppercase; letter-spacing: .08em; }
  .status i { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  .live { color: var(--live); } .live i { box-shadow: 0 0 0 4px color-mix(in srgb, var(--live) 20%, transparent); }
  .building { color: var(--building); } .idea { color: var(--idea); } .retired { color: var(--ink-3); }
  .year { font-size: 0.8rem; color: var(--ink-3); }
  .tag { color: var(--ink-2); flex: 1; }
  .metric { font: 600 0.9rem var(--mono); }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; }
</style>
