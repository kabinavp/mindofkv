---
// Mind of KV logo: the mascot leaning on the "M", one hand resting on top of it. "of" in the mascot's orange.
import Mascot from './Mascot.astro';
---
<a href="/" class="logo" aria-label="Mind of KV, home">
  <span class="kv"><Mascot height={35} /></span>
  <span class="word">Mind <i>of</i> KV</span>
</a>
<style>
  .logo { display: inline-flex; align-items: flex-end; color: var(--ink); line-height: 1; }
  .kv { margin-right: -3px; transform-origin: 50% 100%; transition: transform .45s cubic-bezier(.2,.8,.2,1.3); }
  .logo:hover .kv { transform: rotate(4deg); }
  .word { font: 500 22px/1 var(--serif); letter-spacing: -0.015em; white-space: nowrap; padding-bottom: 1px; }
  .word i { font-weight: 400; color: var(--accent); }
</style>
