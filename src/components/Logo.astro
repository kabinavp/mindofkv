---
// Mind of KV logo: a small figure leaning on the "M", one hand resting on top of it.
---
<a href="/" class="logo" aria-label="Mind of KV, home">
  <svg class="kv" viewBox="0 0 24 40" aria-hidden="true">
    <g stroke-linecap="round" stroke-linejoin="round" fill="none">
      <!-- crossed legs -->
      <path d="M11 26.2 12.4 33 8.6 39.4" stroke="#3b3a35" stroke-width="2.5" />
      <path d="M11 26.2 9.9 33 13.6 39.4" stroke="#2e2d2a" stroke-width="2.5" />
      <path d="M7.2 39.6h2.6M12.6 39.6h2.8" stroke="#2e2d2a" stroke-width="1.6" />
      <!-- back arm, hand in pocket -->
      <path d="M12.6 16.4 9.6 21.2 10.6 25" stroke="#a8572f" stroke-width="1.9" />
      <!-- torso -->
      <path d="M11 26 13.6 15.8" stroke="#c8582b" stroke-width="4.6" />
      <!-- front arm resting on the M -->
      <path class="arm" d="M14 16.4 19 19.2 23.6 17.4" stroke="#c8582b" stroke-width="2" />
      <path d="M23.2 17.4 25.6 16.9" stroke="#a8724f" stroke-width="2.1" />
    </g>
    <!-- head and cap -->
    <circle cx="13.4" cy="11.2" r="3.3" fill="#a8724f" />
    <path d="M10 10.6c0-2.6 1.6-3.9 3.6-3.9s3.4 1.3 3.4 3.4z" fill="#2e2d2a" />
    <path d="M16.4 9.9 19.4 10.4" stroke="#2e2d2a" stroke-width="1.3" stroke-linecap="round" />
  </svg>
  <span class="word"><span class="m">Mind</span> <i>of</i> KV</span>
</a>
<style>
  .logo { display: inline-flex; align-items: flex-end; color: var(--ink); line-height: 1; }
  .kv { width: 21px; height: 35px; margin-right: -3px; overflow: visible; transform-origin: 50% 100%; transition: transform .45s cubic-bezier(.2,.8,.2,1.3); }
  .logo:hover .kv { transform: rotate(4deg); }
  .word { font: 500 22px/1 var(--serif); letter-spacing: -0.015em; white-space: nowrap; padding-bottom: 1px; }
  .word i { font-weight: 400; color: var(--ink-3); }
</style>
