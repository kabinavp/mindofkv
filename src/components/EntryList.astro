---
import { fmtDate } from '../lib/content';
interface Row { title: string; href: string; date?: Date; kind?: string; note?: string; }
interface Props { rows: Row[]; }
const { rows } = Astro.props;
---
<ul class="entries">
  {rows.map((r) => (
    <li>
      <a href={r.href}>
        <span class="t">{r.title}{r.note && <span class="note"> — {r.note}</span>}</span>
        <span class="dots" aria-hidden="true"></span>
        <span class="meta">{r.kind && `${r.kind} · `}{r.date && fmtDate(r.date)}</span>
      </a>
    </li>
  ))}
</ul>
<style>
  .entries { list-style: none; margin: 0; padding: 0; max-width: 680px; }
  a { display: flex; align-items: baseline; gap: 10px; padding: 5px 0; }
  .t { color: var(--ink); transition: color .2s; } .note { color: var(--ink-3); }
  .dots { flex: 1; min-width: 24px; border-bottom: 1px dotted var(--line); transform: translateY(-5px); }
  .meta { white-space: nowrap; }
  a:hover .t { color: var(--ink-2); }
  @media (max-width: 560px) { a { flex-direction: column; gap: 0; padding: 7px 0; } .dots { display: none; } }
</style>
