---
import Logo from './Logo.astro';
import { SITE } from '../site.config';
const path = Astro.url.pathname;
const on = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="hdr">
  <Logo />
  <nav aria-label="Main">{SITE.nav.map((n) => <a href={n.href} aria-current={on(n.href) ? 'page' : undefined}>{n.label}</a>)}</nav>
</header>
<style>
  .hdr { position: absolute; z-index: 20; top: 0; left: 0; right: 0; display: flex; align-items: center; gap: 34px; padding: 20px var(--gut) 0; font: 400 14px/1 var(--sans); }
  nav { display: flex; gap: 20px; flex-wrap: wrap; }
  nav a { color: var(--ink-3); transition: color .2s; }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
  @media (max-width: 640px) { .hdr { flex-direction: column; align-items: flex-start; gap: 12px; font-size: 13.5px; } nav { gap: 6px 14px; } }
</style>
