---
import { SITE } from '../site.config';
interface Props { variant?: 'inline' | 'card'; }
const { variant = 'card' } = Astro.props;
const n = SITE.newsletter;
---
<section class:list={['nl', variant]}>
  {variant === 'card' && (
    <div class="copy">
      <p class="eyebrow">Newsletter</p>
      <h2>{n.name}</h2>
      <p class="muted">{n.pitch}</p>
    </div>
  )}
  <form action={n.action} method="post" target="_blank" class="form">
    <label class="sr" for={`email-${variant}`}>Email address</label>
    <input id={`email-${variant}`} type="email" name={n.emailField} placeholder="you@example.com" required autocomplete="email" />
    <button type="submit" class="btn accent">Join free</button>
  </form>
  <p class="fine">No spam. Unsubscribe in one click.</p>
</section>
<style>
  .card { background: var(--ink); color: var(--bg); border-radius: 22px; padding: clamp(28px, 5vw, 56px); display: grid; gap: 20px; grid-template-columns: 1.2fr 1fr; align-items: center; }
  .card .muted { color: color-mix(in srgb, var(--bg) 75%, transparent); margin-top: 10px; }
  .card .eyebrow { color: var(--accent); }
  .card .fine { grid-column: 2; }
  .form { display: flex; gap: 8px; background: var(--surface); padding: 6px; border-radius: 999px; border: 1px solid var(--line); }
  input { flex: 1; min-width: 0; border: 0; background: transparent; padding: 0 14px; font: inherit; color: var(--ink); outline: none; }
  .fine { font-size: 0.8rem; opacity: 0.6; margin-top: -8px; padding-left: 16px; }
  .inline { display: grid; gap: 14px; max-width: 460px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  @media (max-width: 800px) { .card { grid-template-columns: 1fr; } .card .fine { grid-column: 1; } }
  @media (max-width: 420px) { .form { flex-direction: column; border-radius: 16px; } input { padding: 12px 14px; } .btn { justify-content: center; } }
</style>
