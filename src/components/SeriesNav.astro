---
import { getEntry } from 'astro:content';
import { getSeriesItems, hrefOf } from '../lib/content';
interface Props { seriesId: string; currentId: string; }
const { seriesId, currentId } = Astro.props;
const series = await getEntry('series', seriesId);
const items = await getSeriesItems(seriesId);
const idx = items.findIndex((i) => i.entry.id === currentId);
const prev = items[idx - 1], next = items[idx + 1];
---
{series && (
  <aside class="sn">
    <p>Part {idx + 1} of {items.length} in <a href={`/series/${seriesId}`} class="u">{series.data.title}</a>.</p>
    <p class="pn">
      {prev && <a href={hrefOf(prev)} class="u">← {prev.entry.data.title}</a>}
      {next && <a href={hrefOf(next)} class="u next">{next.entry.data.title} →</a>}
    </p>
  </aside>
)}
<style>
  .sn { max-width: 600px; padding: 14px 18px; background: rgba(244, 228, 178, .45); border: 1px solid var(--stamp-edge); border-radius: 3px; font-size: 15.5px; }
  .pn { display: flex; justify-content: space-between; gap: 16px; margin-top: 6px !important; font-size: 14.5px; }
  .next { margin-left: auto; text-align: right; }
</style>
