---
import { getEntry } from 'astro:content';
import { getSeriesItems, hrefOf } from '../lib/content';
interface Props { seriesId: string; currentId: string; }
const { seriesId, currentId } = Astro.props;
const series = await getEntry('series', seriesId);
const items = await getSeriesItems(seriesId);
const idx = items.findIndex((i) => i.entry.id === currentId);
const prev = items[idx - 1], next = items[idx + 1];
---
{series && (
  <nav class="sn" aria-label="Series navigation">
    <div class="top"><span class="label">Part {idx + 1} of {items.length}</span><a href={`/series/${seriesId}`} class="name">{series.data.title}</a></div>
    <div class="pn">
      <div>{prev && <><p class="label">Previous</p><a href={hrefOf(prev)}>{prev.entry.data.title}</a></>}</div>
      <div class="n">{next && <><p class="label">Next</p><a href={hrefOf(next)}>{next.entry.data.title}</a></>}</div>
    </div>
  </nav>
)}
<style>
  .sn { border-top: 1px solid var(--ink); padding-top: 14px; }
  .top { display: flex; justify-content: space-between; gap: 16px; }
  .name { font-size: 13px; } .name:hover { color: var(--ink-2); }
  .pn { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 28px; }
  .pn a { font-size: 17px; letter-spacing: -0.025em; line-height: 1.25; display: block; margin-top: 4px; } .pn a:hover { color: var(--ink-2); }
  .n { text-align: right; }
</style>
