---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<a href="/" class:list={['wm', { compact }]} aria-label="Mind of KV — home">
  <svg class="glyph" viewBox="0 0 22 22" aria-hidden="true">
    <path d="M3 2.5v17" />
    <path d="M12.5 2.5 3.6 11l8.9 8.5" />
    <path d="M10.5 2.5 15 19.5 19.5 2.5" />
  </svg>
  <span class="word">mindofkv</span>
</a>
<style>
  .wm { display: inline-flex; align-items: center; gap: 7px; color: inherit; }
  .glyph { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; transition: transform .6s var(--ease); }
  .wm:hover .glyph { transform: rotate(-8deg); }
  .word { font: 500 16px/1 var(--sans); letter-spacing: -0.045em; transition: opacity .3s, max-width .5s var(--ease); max-width: 100px; overflow: hidden; }
  .compact .word { opacity: 0; max-width: 0; }
</style>
