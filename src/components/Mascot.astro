---
// KV, the site's mascot: a small figure in an orange top and cap, leaning casually.
interface Props { height?: number; class?: string; title?: string; }
const { height = 35, class: cls, title } = Astro.props;
---
<svg class:list={['mascot', cls]} viewBox="0 0 24 40" style={`height:${height}px;width:${(height * 24) / 40}px`} role={title ? 'img' : undefined} aria-label={title} aria-hidden={title ? undefined : 'true'}>
  <g stroke-linecap="round" stroke-linejoin="round" fill="none">
    <path d="M11 26.2 12.4 33 8.6 39.4" stroke="#3b3a35" stroke-width="2.5" />
    <path d="M11 26.2 9.9 33 13.6 39.4" stroke="#2e2d2a" stroke-width="2.5" />
    <path d="M7.2 39.6h2.6M12.6 39.6h2.8" stroke="#2e2d2a" stroke-width="1.6" />
    <path d="M12.6 16.4 9.6 21.2 10.6 25" stroke="#a8572f" stroke-width="1.9" />
    <path d="M11 26 13.6 15.8" stroke="#c8582b" stroke-width="4.6" />
    <path class="arm" d="M14 16.4 19 19.2 23.6 17.4" stroke="#c8582b" stroke-width="2" />
    <path d="M23.2 17.4 25.6 16.9" stroke="#a8724f" stroke-width="2.1" />
  </g>
  <circle cx="13.4" cy="11.2" r="3.3" fill="#a8724f" />
  <path d="M10 10.6c0-2.6 1.6-3.9 3.6-3.9s3.4 1.3 3.4 3.4z" fill="#2e2d2a" />
  <path d="M16.4 9.9 19.4 10.4" stroke="#2e2d2a" stroke-width="1.3" stroke-linecap="round" />
</svg>
<style>.mascot { display: block; overflow: visible; flex: none; }</style>
