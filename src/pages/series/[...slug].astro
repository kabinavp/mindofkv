---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getSeries, getSeriesItems, hrefOf } from '../../lib/content';

export async function getStaticPaths() {
  return (await getSeries()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const items = await getSeriesItems(entry.id);
const { title, description, status } = entry.data;
---
<Base title={title} description={description}>
  <div class="page">
    <p class="meta">Series · {status} · {items.length} {items.length === 1 ? 'part' : 'parts'}</p>
    <h1 class="title" style="margin-top:10px">{title}</h1>
    <p class="dek">{description}</p>
    <div class="prose" style="margin-top:28px"><Content /></div>
    <h2 class="sub-h">Parts</h2>
    <EntryList rows={items.map((it, i) => ({ title: `${i + 1}. ${it.entry.data.title}`, href: hrefOf(it), date: it.entry.data.date, kind: it.kind === 'video' ? 'Video' : 'Essay' }))} />
    {status !== 'complete' && <p class="meta" style="margin-top:14px">More parts on the way. The newsletter gets them first.</p>}
  </div>
</Base>
<style>.dek { font-size: 19px; color: var(--ink-3); font-style: italic; max-width: 600px; }</style>
