---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getSeries, getSeriesItems, hrefOf, fmtDate } from '../../lib/content';

export async function getStaticPaths() {
  return (await getSeries()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const items = await getSeriesItems(entry.id);
const { title, description, status, hue } = entry.data;
---
<Base title={title} description={description}>
  <header class="banner" style={`--h:${hue}`}>
    <div class="wrap">
      <p class="eyebrow">Series · {status} · {items.length} parts</p>
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      {items[0] && <a href={hrefOf(items[0])} class="btn">Start with part 1</a>}
    </div>
  </header>
  <div class="wrap body">
    <div class="prose intro"><Content /></div>
    <ol class="parts">
      {items.map((i, n) => (
        <li>
          <a href={hrefOf(i)}>
            <span class="n">{String(n + 1).padStart(2, '0')}</span>
            <span class="t">{i.entry.data.title}<small>{i.kind === 'video' ? '▶ Video' : 'Article'} · {fmtDate(i.entry.data.date)}</small></span>
          </a>
        </li>
      ))}
      {status !== 'complete' && <li class="more"><span class="n">··</span><span class="t">More parts on the way — subscribe to get them first.</span></li>}
    </ol>
  </div>
  <section class="wrap" style="margin-top:72px"><Newsletter /></section>
</Base>
<style>
  .banner { padding: 80px 0 56px; color: #fff; background: linear-gradient(150deg, hsl(var(--h) 70% 50%), hsl(calc(var(--h) + 35) 65% 24%)); }
  .banner .eyebrow { color: rgba(255,255,255,.8); }
  .banner h1 { margin: 14px 0 16px; }
  .dek { font-size: 1.2rem; max-width: 56ch; opacity: .9; margin-bottom: 28px; }
  .banner .btn { background: #fff; color: #111; border-color: #fff; }
  .body { padding-top: 56px; }
  .intro { margin: 0 auto 40px; }
  .parts { list-style: none; padding: 0; margin: 0 auto; max-width: var(--prose); border-top: 1px solid var(--line); }
  .parts li a, .more { display: flex; gap: 20px; padding: 18px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .n { font: 500 0.9rem var(--mono); color: var(--accent); padding-top: 4px; }
  .t { font: 500 1.2rem/1.3 var(--serif); display: flex; flex-direction: column; gap: 4px; }
  .t small { font: 0.82rem var(--sans); color: var(--ink-3); }
  .parts a:hover .t { color: var(--accent); }
  .more .t { color: var(--ink-3); font-style: italic; }
</style>
