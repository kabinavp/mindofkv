---
import Base from '../../layouts/Base.astro';
import { getSeries, getSeriesItems, hrefOf } from '../../lib/content';
const series = await getSeries();
const rows = await Promise.all(series.map(async (s) => ({ s, items: await getSeriesItems(s.id) })));
---
<Base title="Series" description="Multi-part deep dives you can follow start to finish.">
  <div class="page">
    <h1 class="title">Series</h1>
    <p>Longer projects told in parts. Each one is a set of essays and videos on a single theme, best read in order.</p>
    {rows.map(({ s, items }) => (
      <section class="s">
        <h2 class="sub-h"><a href={`/series/${s.id}`} class="u">{s.data.title}</a> <span class="meta">· {s.data.status} · {items.length} {items.length === 1 ? 'part' : 'parts'}</span></h2>
        <p>{s.data.description}</p>
        {items.length > 0 && <ol class="parts">{items.map((it) => <li><a href={hrefOf(it)} class="u">{it.entry.data.title}</a>{it.kind === 'video' && <span class="meta"> · video</span>}</li>)}</ol>}
      </section>
    ))}
  </div>
</Base>
<style>
  .s { max-width: 600px; } .sub-h .meta { font-style: normal; }
  .parts { margin: 12px 0 0; padding-left: 1.4em; color: var(--ink-3); } .parts li { padding: 2px 0; }
</style>
