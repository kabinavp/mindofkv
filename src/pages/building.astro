---
import Base from '../layouts/Base.astro';
import ProductCell from '../components/ProductCell.astro';
import { getProducts } from '../lib/content';
const products = await getProducts();
const count = (s: string) => products.filter((p) => p.data.status === s).length;
---
<Base title="Building" description="Products, side projects and experiments, built in public.">
  <div class="wrap">
    <header class="page-head">
      <p class="label">Building</p>
      <div>
        <h1>Things I’m making</h1>
        <p class="lead"><b>The best way to learn is to ship.</b> Everything I’ve built, am building, or want to build — with real numbers, including the projects that didn’t work out.</p>
      </div>
    </header>
    <div class="cols facts">
      {[['Live', count('live')], ['Building', count('building')], ['Ideas', count('idea')], ['Retired', count('retired')]].map(([l, v]) => (
        <div><p class="label">{l}</p><p class="stat">{String(v).padStart(2, '0')}</p></div>
      ))}
    </div>
    <div class="grid">{products.map((p) => <ProductCell entry={p} />)}</div>
  </div>
  <div style="height:128px"></div>
</Base>
<style>
  .facts > div { height: 200px; display: flex; flex-direction: column; justify-content: space-between; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; margin-top: 120px; border-right: 1px solid var(--line); row-gap: 72px; }
  @media (max-width: 760px) { .facts { grid-template-columns: 1fr 1fr; } .facts > div { height: 140px; } .grid { grid-template-columns: 1fr; margin-top: 72px; } }
</style>
