---
import Base from '../../layouts/Base.astro';
import { getVideos, fmtDate } from '../../lib/content';
import { SITE } from '../../site.config';
const videos = await getVideos();
const yt = SITE.socials.find((s) => s.label === 'YouTube');
---
<Base title="Videos" description="Build logs, walkthroughs and conversations.">
  <div class="page">
    <h1 class="title">Videos</h1>
    <p>Build logs and walkthroughs, filmed while the work happens. New ones land on {yt ? <a href={yt.href} class="u" target="_blank" rel="noopener">YouTube</a> : 'YouTube'} first.</p>
    <ul class="vids">
      {videos.map((v) => (
        <li><a href={`/videos/${v.id}`}>
          <span class="thumb">
            {v.data.youtubeId
              ? <img src={`https://i.ytimg.com/vi/${v.data.youtubeId}/mqdefault.jpg`} alt="" loading="lazy" />
              : <svg viewBox="0 0 160 90" aria-hidden="true"><rect width="160" height="90" fill="#e9e8e1" /><path d="M0 64c30-8 52-6 80 2s52 4 80-6v30H0z" fill="#8a9c3c" /><path d="M0 72c34-6 60-2 90 4s50 2 70-4v18H0z" fill="#6c8530" /><path d="m72 34 18 11-18 11z" fill="#2e2d2a" /></svg>}
            {v.data.duration && <span class="dur">{v.data.duration}</span>}
          </span>
          <span class="t">{v.data.title}</span>
          <span class="meta">{fmtDate(v.data.date)}</span>
        </a></li>
      ))}
    </ul>
  </div>
</Base>
<style>
  .vids { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 36px 24px; max-width: 760px; }
  .vids a { display: grid; gap: 8px; }
  .thumb { position: relative; display: block; aspect-ratio: 16 / 9; border-radius: 3px; overflow: hidden; border: 1px solid var(--line); background: #e9e8e1; }
  .thumb img, .thumb svg { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .vids a:hover img, .vids a:hover svg { transform: scale(1.03); }
  .dur { position: absolute; right: 6px; bottom: 6px; padding: 0 5px; border-radius: 2px; background: rgba(30, 30, 25, .75); color: #fff; font: 500 11px/1.6 var(--sans); }
  .t { color: var(--ink); line-height: 1.35; }
</style>
