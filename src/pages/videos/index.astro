---
import Base from '../../layouts/Base.astro';
import VideoCard from '../../components/VideoCard.astro';
import { getVideos } from '../../lib/content';
import { SITE } from '../../site.config';
const videos = await getVideos();
const yt = SITE.socials.find((s) => s.label === 'YouTube');
---
<Base title="Videos" description="Videos on building, tools and the creative process.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Watch</p>
      <h1>Videos</h1>
      <p>Build logs, walkthroughs and conversations. New videos land on YouTube first.</p>
      {yt && <p style="margin-top:24px"><a class="btn" href={yt.href} target="_blank" rel="noopener">Subscribe on YouTube</a></p>}
    </header>
    <div class="grid">{videos.map((v) => <VideoCard entry={v} />)}</div>
  </div>
</Base>
