---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import { getVideos, fmtDate, slugify } from '../../lib/content';

export async function getStaticPaths() {
  return (await getVideos()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, youtubeId, topics, series, duration } = entry.data;
---
<Base title={title} description={description} type="article" image={youtubeId && `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`}>
  <article class="wrap">
    <div class="player">
      {youtubeId
        ? <iframe src={`https://www.youtube-nocookie.com/embed/${youtubeId}`} title={title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        : <div class="soon"><p class="eyebrow">Coming soon</p><p>{title}</p></div>}
    </div>
    <header class="head">
      <p class="eyebrow">{fmtDate(date)}{duration && ` · ${duration}`}</p>
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      {topics.length > 0 && <p class="topics">{topics.map((t) => <a class="pill" href={`/topics/${slugify(t)}`}>{t}</a>)}</p>}
    </header>
    {series && <SeriesNav seriesId={series.id} currentId={entry.id} />}
    <div class="prose"><Content /></div>
  </article>
  <section class="wrap" style="margin-top:80px"><Newsletter /></section>
</Base>
<style>
  .player { max-width: 960px; margin: 40px auto 0; aspect-ratio: 16/9; border-radius: 18px; overflow: hidden; background: var(--ink); }
  .player iframe { width: 100%; height: 100%; border: 0; }
  .soon { height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 10px; color: var(--bg); font: 500 1.6rem var(--serif); text-align: center; padding: 24px;
    background: radial-gradient(circle at 80% 20%, var(--accent) 0, transparent 50%), var(--ink); }
  .soon .eyebrow { color: var(--bg); opacity: .7; }
  .head { max-width: var(--prose); margin: 0 auto; padding: 40px 0; }
  .head h1 { font-size: clamp(2rem, 4.5vw, 3rem); margin-top: 12px; }
  .dek { font-size: 1.2rem; color: var(--ink-2); margin-top: 16px; }
  .topics { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 18px; }
</style>
