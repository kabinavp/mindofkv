---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import { getVideos, fmtDate, slugify } from '../../lib/content';

export async function getStaticPaths() {
  return (await getVideos()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, youtubeId, topics, series, duration } = entry.data;
---
<Base title={title} description={description} type="article" image={youtubeId && `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`}>
  <article class="page">
    <p class="meta">{fmtDate(date)}{duration && ` · ${duration}`}{topics.length > 0 && <> · {topics.map((t, k) => <>{k > 0 && ', '}<a href={`/topics/${slugify(t)}`} class="u">{t}</a></>)}</>}</p>
    <h1 class="title" style="margin-top:10px">{title}</h1>
    <p class="dek">{description}</p>
    <div class="player">
      {youtubeId
        ? <iframe src={`https://www.youtube-nocookie.com/embed/${youtubeId}`} title={title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        : <div class="soon"><span>Premieres soon</span></div>}
    </div>
    {series && <div style="margin-bottom:36px"><SeriesNav seriesId={series.id} currentId={entry.id} /></div>}
    <div class="prose"><Content /></div>
  </article>
</Base>
<style>
  .dek { font-size: 19px; color: var(--ink-3); font-style: italic; max-width: 600px; }
  .player { max-width: 760px; aspect-ratio: 16 / 9; margin: 36px 0; border-radius: 3px; overflow: hidden; border: 1px solid var(--line); background: #e9e8e1; }
  .player iframe { width: 100%; height: 100%; border: 0; }
  .soon { height: 100%; display: grid; place-items: center; background: linear-gradient(transparent 70%, #8a9c3c 70%); }
  .soon span { font: italic 400 20px var(--serif); color: var(--ink-2); }
</style>
