---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Field from '../../components/Field.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import Subscribe from '../../components/Subscribe.astro';
import { getVideos, fmtDate, slugify } from '../../lib/content';

export async function getStaticPaths() {
  return (await getVideos()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, youtubeId, topics, series, duration, palette } = entry.data;
---
<Base title={title} description={description} type="article" image={youtubeId && `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`}>
  <div class="wrap stage">
    <div class="frame">
      <Field seed={entry.id} palette={palette} />
      <div class="player">
        {youtubeId
          ? <iframe src={`https://www.youtube-nocookie.com/embed/${youtubeId}`} title={title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          : <div class="soon glass"><p class="g-dim">Premieres soon</p><p class="g-title">{title}</p></div>}
      </div>
    </div>
  </div>
  <div class="wrap info">
    <dl>
      <div><dt>Released</dt><dd>{fmtDate(date)}</dd></div>
      {duration && <div><dt>Length</dt><dd>{duration}</dd></div>}
      {topics.length > 0 && <div><dt>Topics</dt><dd>{topics.map((t, i) => <>{i > 0 && ', '}<a href={`/topics/${slugify(t)}`}>{t}</a></>)}</dd></div>}
    </dl>
    <div class="main">
      <h1>{title}</h1>
      <p class="lead" style="margin-top:20px">{description}</p>
      {series && <div style="margin-top:56px"><SeriesNav seriesId={series.id} currentId={entry.id} /></div>}
      <div class="prose" style="margin-top:56px"><Content /></div>
      <div class="sub"><p class="lead"><b>Get the next one first.</b> New videos go out to the Build Log before anywhere else.</p><Subscribe id="vid-email" /></div>
    </div>
  </div>
</Base>
<style>
  .stage { padding-top: 120px; }
  .frame { position: relative; border-radius: 28px; aspect-ratio: 16 / 9.4; }
  .player { position: absolute; left: 50%; top: 50%; width: 76%; aspect-ratio: 16 / 9; transform: translate(-50%, -50%); border-radius: 14px; overflow: hidden; box-shadow: 0 30px 60px -20px rgba(0,0,0,.35); }
  .player iframe { width: 100%; height: 100%; border: 0; }
  .soon { position: absolute; inset: 0; border-radius: 14px; display: grid; place-content: center; text-align: center; gap: 8px; }
  .soon .g-title { font-size: clamp(18px, 2.4vw, 28px); letter-spacing: -0.035em; }
  .info { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; padding-top: 72px; padding-bottom: 128px; }
  dl { margin: 0; display: grid; gap: 12px; font-size: 12.5px; align-content: start; }
  dt { color: var(--ink-3); } dd { margin: 0; }
  .main { grid-column: 2 / 5; }
  .sub { display: grid; gap: 24px; border-top: 1px solid var(--line); padding-top: 32px; margin-top: 80px; max-width: 640px; }
  @media (max-width: 860px) {
    .stage { padding-top: 96px; } .frame { aspect-ratio: 4/3; } .player { width: 88%; }
    .info { grid-template-columns: 1fr; } .main { grid-column: 1; } dl { order: 2; }
  }
</style>
