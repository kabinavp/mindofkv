---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getArticles, getAllTopics } from '../../lib/content';
const articles = await getArticles();
const topics = await getAllTopics();
const years = [...new Set(articles.map((a) => a.data.date.getFullYear()))].sort((a, b) => b - a);
---
<Base title="Writing" description="Essays and notes on building, thinking and making things.">
  <div class="page">
    <h1 class="title">Writing</h1>
    <p>Essays and notes from the workshop. Some are polished, some are me thinking out loud.</p>
    <p class="meta topics">Topics: {topics.map((t, i) => <>{i > 0 && ', '}<a href={`/topics/${t.slug}`} class="u">{t.name}</a></>)}</p>
    {years.map((y) => (
      <section>
        <h2 class="sub-h">{y}</h2>
        <EntryList rows={articles.filter((a) => a.data.date.getFullYear() === y).map((a) => ({ title: a.data.title, href: `/articles/${a.id}`, date: a.data.date }))} />
      </section>
    ))}
  </div>
</Base>
<style>.topics { margin-top: 18px !important; font-size: 13px; } .topics .u { color: var(--ink-2); }</style>
