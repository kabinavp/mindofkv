---
import Base from '../../layouts/Base.astro';
import { getArticles, fmtDate, getAllTopics } from '../../lib/content';
const articles = await getArticles();
const topics = await getAllTopics();
const byYear = Object.entries(
  articles.reduce<Record<string, typeof articles>>((acc, a) => {
    (acc[a.data.date.getFullYear()] ??= []).push(a); return acc;
  }, {}),
).sort((a, b) => Number(b[0]) - Number(a[0]));
---
<Base title="Articles" description="Essays and notes on building, thinking and making things.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Writing</p>
      <h1>Articles</h1>
      <p>Essays, notes and breakdowns from the workshop. Some are polished, some are thinking out loud.</p>
      <div class="topics">{topics.map((t) => <a class="pill" href={`/topics/${t.slug}`}>{t.name}</a>)}</div>
    </header>
    {byYear.map(([year, list]) => (
      <section class="year">
        <h2>{year}</h2>
        <ul>
          {list.map((a) => (
            <li><a href={`/articles/${a.id}`}><span class="t">{a.data.title}</span><span class="d">{fmtDate(a.data.date)}</span></a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
<style>
  .topics { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .year { display: grid; grid-template-columns: 160px 1fr; gap: 24px; padding: 32px 0; border-top: 1px solid var(--line); }
  .year h2 { font-size: 1.4rem; color: var(--ink-3); }
  ul { list-style: none; margin: 0; padding: 0; }
  li a { display: flex; justify-content: space-between; gap: 24px; padding: 12px 0; text-decoration: none; border-bottom: 1px dashed var(--line); }
  li:last-child a { border-bottom: 0; }
  .t { font: 500 1.2rem/1.3 var(--serif); } li a:hover .t { color: var(--accent); }
  .d { color: var(--ink-3); font-size: 0.88rem; white-space: nowrap; padding-top: 4px; }
  @media (max-width: 640px) { .year { grid-template-columns: 1fr; gap: 8px; } li a { flex-direction: column; gap: 2px; } }
</style>
