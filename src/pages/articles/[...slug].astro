---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import { getArticles, fmtDate, readingTime, slugify } from '../../lib/content';

export async function getStaticPaths() {
  const all = await getArticles();
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, topics, series } = entry.data;
const i = all.findIndex((a) => a.id === entry.id);
const older = all[i + 1];
---
<Base title={title} description={description} type="article">
  <article class="page">
    <p class="meta">{fmtDate(date)} · {readingTime(entry.body)} min read{topics.length > 0 && <> · {topics.map((t, k) => <>{k > 0 && ', '}<a href={`/topics/${slugify(t)}`} class="u">{t}</a></>)}</>}</p>
    <h1 class="title" style="margin-top:10px">{title}</h1>
    <p class="dek">{description}</p>
    {series && <div style="margin:36px 0"><SeriesNav seriesId={series.id} currentId={entry.id} /></div>}
    <div class="prose" style="margin-top:36px"><Content /></div>
    {older && <p class="more">Older: <a href={`/articles/${older.id}`} class="u">{older.data.title}</a></p>}
  </article>
</Base>
<style>
  .dek { font-size: 19px; color: var(--ink-3); font-style: italic; max-width: 600px; }
  .more { margin-top: 64px !important; font-size: 15.5px; }
</style>
