---
import Base from '../layouts/Base.astro';
const updated = 'November 2026'; // update when you edit this page
const rows = [
  { k: 'Building', v: ['Shipping v1 of my current side project.', 'Rebuilding this website — you’re looking at it.'] },
  { k: 'Learning', v: ['Getting comfortable on camera, one video at a time.'] },
  { k: 'Reading', v: ['Add the books you’re reading here.'] },
  { k: 'Thinking about', v: ['How to build a body of work, not just a list of projects.'] },
];
---
<Base title="Now" description="What I'm focused on right now.">
  <div class="wrap">
    <header class="page-head">
      <p class="label">Now · {updated}</p>
      <div>
        <h1>What I’m doing now</h1>
        <p class="lead"><b>A snapshot of my current focus.</b> Inspired by the <a href="https://nownownow.com/about" style="text-decoration:underline;text-underline-offset:3px">now page movement</a>. Updated every month or so.</p>
      </div>
    </header>
    <dl class="now">
      {rows.map((r, i) => (
        <div class="row">
          <dt><span class="idx">{String(i + 1).padStart(2, '0')}</span>{r.k}</dt>
          <dd>{r.v.map((x) => <p>{x}</p>)}</dd>
        </div>
      ))}
    </dl>
  </div>
  <div style="height:128px"></div>
</Base>
<style>
  .now { margin: 0; border-top: 1px solid var(--line); }
  .row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; padding: 28px 0 40px; border-bottom: 1px solid var(--line); }
  dt { font-size: 13px; display: flex; gap: 14px; align-items: baseline; }
  dd { grid-column: 2 / 5; margin: 0; display: grid; gap: 6px; font-size: 22px; letter-spacing: -0.03em; line-height: 1.3; }
  @media (max-width: 760px) { .row { grid-template-columns: 1fr; gap: 14px; } dd { grid-column: 1; font-size: 19px; } }
</style>
