---
import Base from '../layouts/Base.astro';
const updated = 'November 2026'; // update when you edit this page
---
<Base title="Now" description="What I'm focused on right now.">
  <div class="page">
    <p class="meta">Updated {updated}</p>
    <h1 class="title" style="margin-top:10px">Now</h1>
    <div class="prose">
      <p>What I’m focused on at the moment. This is a <a href="https://nownownow.com/about">now page</a>; I update it every month or so.</p>
      <h2>Making</h2>
      <ul><li>Getting my current side project to a first version.</li><li>This website.</li></ul>
      <h2>Riding</h2>
      <ul><li>Hill repeats twice a week. Add your current goal here.</li></ul>
      <h2>Reading</h2>
      <ul><li>Add the books you’re reading here.</li></ul>
    </div>
  </div>
</Base>
