---
import Base from '../layouts/Base.astro';
import Subscribe from '../components/Subscribe.astro';
import { SITE } from '../site.config';
const n = SITE.newsletter;
---
<Base title={n.name} description={n.pitch} bare>
  <div class="page">
    <h1 class="title">{n.name}</h1>
    <p class="measure">{n.pitch} It’s written for builders and readable by anyone.</p>
    <div style="margin-top:28px"><Subscribe id="nl-email" /></div>
    <p class="meta" style="margin-top:12px">Free. Unsubscribe in one click.</p>
    <ul class="what">
      <li><span class="ink">What I shipped:</span> progress, numbers and screenshots.</li>
      <li><span class="ink">What broke:</span> the mistakes and what they taught me.</li>
      <li><span class="ink">What I read:</span> one link worth your time.</li>
    </ul>
  </div>
</Base>
<style>.what { margin: 48px 0 0; padding-left: 1.1em; max-width: 560px; } .what li + li { margin-top: 4px; } .what li::marker { color: var(--ink-3); }</style>
