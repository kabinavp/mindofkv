---
import Base from '../layouts/Base.astro';
import Subscribe from '../components/Subscribe.astro';
import { SITE } from '../site.config';
const n = SITE.newsletter;
---
<Base title={n.name} description={n.pitch} bare>
  <div class="page">
    <h1 class="title">{n.name}</h1>
    <p class="measure">{n.pitch}</p>
    <div style="margin-top:28px"><Subscribe id="nl-email" /></div>
    <p class="meta" style="margin-top:12px">Free. Unsubscribe in one click.</p>
    <ul class="what">
      <li><span class="ink">Something I found:</span> an idea, a fact or a question I couldn’t shake.</li>
      <li><span class="ink">Something I tried:</span> an experiment, a project or a ride, and how it went.</li>
      <li><span class="ink">Something to read:</span> one link or book worth your time.</li>
    </ul>
  </div>
</Base>
<style>.what { margin: 48px 0 0; padding-left: 1.1em; max-width: 560px; } .what li + li { margin-top: 4px; } .what li::marker { color: var(--ink-3); }</style>
