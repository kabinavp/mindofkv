---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getArticles, getVideos, getAllTopics, slugify } from '../../lib/content';

export async function getStaticPaths() {
  return (await getAllTopics()).map((t) => ({ params: { topic: t.slug }, props: { name: t.name } }));
}
const { topic } = Astro.params;
const { name } = Astro.props;
const has = (e: { data: { topics: string[] } }) => e.data.topics.some((t) => slugify(t) === topic);
const rows = [
  ...(await getArticles()).filter(has).map((e) => ({ title: e.data.title, href: `/articles/${e.id}`, date: e.data.date, kind: 'Essay' })),
  ...(await getVideos()).filter(has).map((e) => ({ title: e.data.title, href: `/videos/${e.id}`, date: e.data.date, kind: 'Video' })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---
<Base title={name} description={`Everything on ${name}.`}>
  <div class="page">
    <p class="meta">Topic</p>
    <h1 class="title" style="margin-top:10px">{name}</h1>
    <p>{rows.length} {rows.length === 1 ? 'piece' : 'pieces'} on {name}.</p>
    <div style="margin-top:40px"><EntryList rows={rows} /></div>
  </div>
</Base>
