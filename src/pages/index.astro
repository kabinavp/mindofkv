---
import Base from '../layouts/Base.astro';
import Stamp from '../components/Stamp.astro';
import Subscribe from '../components/Subscribe.astro';
import { SITE } from '../site.config';

const hill = SITE.hill;
---
<Base bare>
  <section class="home">
    <canvas id="hill" class="hill" role="img" aria-label="A grassy hill with a lone tree. KV rides a bike up and down the slope." data-questions={JSON.stringify(SITE.wondering)}
      data-lat={hill.lat ?? ''} data-lon={hill.lon ?? ''}></canvas>

    <div class="intro">
      <h1>Hi, I’m KV.</h1>
      <p>I chase ideas, ride hills, read too many books, and make things just to see what happens. This is my notebook, where all of it ends up: essays, videos, books and experiments.</p>
      <p class="free">
        <span>In my free time,</span>
        <span class="stamps">
          <Stamp kind="ride" label="I ride. Toggle the cyclist" pressed />
          <Stamp kind="build" label="I make things. Toggle the maker" />
          <Stamp kind="film" label="I film. Toggle the filmmaker" />
        </span>
      </p>
      <p class="wonder">
        <span class="meta">Currently wondering</span>
        <span class="q" data-q>{SITE.wondering[0]}</span>
        <button type="button" class="next-q" data-next-q aria-label="Show another question">another one ↻</button>
      </p>
      <div class="join">
        <p><span class="ink">{SITE.newsletter.name}.</span> One email on Sundays with the most interesting things I found that week.</p>
        <Subscribe id="home-email" />
      </div>
    </div>

    <p class="weather" aria-live="polite">
      <span data-w1>Slight breeze on {hill.spot}</span>
      <span data-w2 class="dim">&nbsp;</span>
    </p>

    <svg class="doodle" viewBox="0 0 40 46" aria-hidden="true" data-doodle>
      <g data-lines fill="none" stroke="#2b2a27" stroke-width="1.3" stroke-linecap="round" opacity="0">
        <path d="M6 17c-2 1.5-4 1.5-6 0" /><path d="M6 23c-2.5 1.5-5 1.5-7.5 0" /><path d="M6 29c-2 1.5-4 1.5-6 0" />
      </g>
      <path data-face fill="#f1f1ed" stroke="#2b2a27" stroke-width="1.4" stroke-linejoin="round"
        d="M20 6 C28 5.5 32 12 32 21 C32.5 31 27 38 19.5 38 C12 38.5 8 31 8 22 C7.5 12.5 12.5 6.5 20 6 Z" />
      <g data-eyes fill="#2b2a27"><circle cx="16" cy="19" r="1.3" /><circle cx="24" cy="19" r="1.3" /></g>
      <path data-mouth fill="none" stroke="#2b2a27" stroke-width="1.3" stroke-linecap="round" d="M16.5 28 L23.5 28" />
    </svg>
  </section>
</Base>

<script>
  import { Hill, liveWind, describeWind, compass, type Activity } from '../scripts/scene';

  const canvas = document.getElementById('hill') as HTMLCanvasElement;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hill = new Hill(canvas, still);
  const w1 = document.querySelector('[data-w1]')!, w2 = document.querySelector('[data-w2]')!;
  const spot = w1.textContent!.replace(/^Slight breeze on /, '');

  const fmtTime = (tz?: string) => new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: tz });
  const setWeather = (mph: number, deg: number | null, tz?: string, abbr?: string, live = false) => {
    hill.wind.mph = mph;
    if (deg !== null) { const s = -Math.sin((deg * Math.PI) / 180); hill.wind.sign = Math.abs(s) < 0.3 ? Math.sign(s || 1) * 0.3 : s; }
    w1.textContent = `${describeWind(mph)} on ${spot}${live ? ' right now' : ''}`;
    w2.textContent = live
      ? `${fmtTime(tz)} ${abbr ?? ''} · ${Math.round(mph)} mph ${compass(deg ?? 270)} wind`
      : `${fmtTime()} where you are`;
  };
  setWeather(7, 260);
  const lat = parseFloat(canvas.dataset.lat ?? ''), lon = parseFloat(canvas.dataset.lon ?? '');
  if (!Number.isNaN(lat) && !Number.isNaN(lon)) {
    liveWind(lat, lon).then((w) => setWeather(w.mph, w.deg, w.tz, w.abbr, true)).catch(() => {});
  }

  // Run only while visible
  new IntersectionObserver(([e]) => (e.isIntersecting ? hill.start() : hill.stop())).observe(canvas);
  let rt = 0;
  addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => hill.resize(), 120); });
  document.fonts?.ready.then(() => hill.resize());

  // Stamps toggle what KV is doing
  document.querySelectorAll<HTMLButtonElement>('[data-activity]').forEach((b, i) => {
    b.style.setProperty('--r', ['-2deg', '1.5deg', '-1deg'][i]);
    b.addEventListener('click', () => b.setAttribute('aria-pressed', String(hill.toggle(b.dataset.activity as Activity))));
  });

  // Currently wondering: flip through questions
  const qs: string[] = JSON.parse(canvas.dataset.questions ?? '[]');
  const qEl = document.querySelector<HTMLElement>('[data-q]')!;
  let qi = 0;
  document.querySelector('[data-next-q]')?.addEventListener('click', () => {
    qi = (qi + 1) % qs.length;
    qEl.classList.remove('in'); void qEl.offsetWidth; qEl.textContent = qs[qi]; qEl.classList.add('in');
  });

  // Doodle face that follows the cursor
  const doodle = document.querySelector<SVGSVGElement>('[data-doodle]')!;
  if (matchMedia('(pointer: fine)').matches && !still) {
    const face = doodle.querySelector('[data-face]')!, eyes = doodle.querySelector<SVGGElement>('[data-eyes]')!;
    const mouth = doodle.querySelector('[data-mouth]')!, lines = doodle.querySelector<SVGGElement>('[data-lines]')!;
    const boil = [
      'M20 6 C28 5.5 32 12 32 21 C32.5 31 27 38 19.5 38 C12 38.5 8 31 8 22 C7.5 12.5 12.5 6.5 20 6 Z',
      'M20.5 6.3 C28.5 6 31.6 12.5 31.8 21.5 C32 30.5 26.5 38.3 19.8 37.8 C12.3 38 8.3 31.5 8.2 21.6 C8 12 13 6.4 20.5 6.3 Z',
      'M19.6 5.8 C27.6 6.2 32.3 12.2 32.1 20.8 C31.9 31.2 27.2 37.6 20 38.2 C11.8 38.2 7.8 30.6 7.9 22.4 C8.1 12.8 12.2 5.6 19.6 5.8 Z',
    ];
    const MOUTH = { flat: 'M16.5 28 L23.5 28', smile: 'M15.5 26.8 Q20 31.5 24.5 26.8', o: 'M18 28.5 a2 2 0 1 0 4 0 a2 2 0 1 0 -4 0' };
    let tx = -100, ty = -100, x = -100, y = -100, shown = false, happy = false, bi = 0, lastBoil = 0, blinkAt = 3000;
    addEventListener('pointermove', (e) => { tx = e.clientX - 46; ty = e.clientY - 40; if (!shown) { x = tx; y = ty; shown = true; doodle.style.opacity = '1'; } });
    document.addEventListener('pointerover', (e) => { happy = !!(e.target as Element).closest('a, button'); });
    document.addEventListener('pointerleave', () => { doodle.style.opacity = '0'; shown = false; });
    const loop = (now: number) => {
      const dx = tx - x, dy = ty - y;
      x += dx * 0.12; y += dy * 0.12;
      const speed = Math.hypot(dx, dy);
      doodle.style.transform = `translate(${x}px, ${y}px) rotate(${Math.max(-12, Math.min(12, dx * 0.15))}deg)`;
      lines.setAttribute('opacity', speed > 60 ? '1' : '0');
      lines.setAttribute('transform', `rotate(${(Math.atan2(dy, dx) * 180) / Math.PI} 20 22)`);
      const look = Math.min(1, speed / 40);
      const blink = now > blinkAt && now < blinkAt + 120;
      if (now > blinkAt + 120) blinkAt = now + 2500 + Math.random() * 3000;
      eyes.setAttribute('transform', `translate(${(dx / (speed || 1)) * 1.6 * look} ${(dy / (speed || 1)) * 1.2 * look}) ${blink ? 'translate(0 19) scale(1 0.15) translate(0 -19)' : ''}`);
      mouth.setAttribute('d', speed > 60 ? MOUTH.o : happy ? MOUTH.smile : MOUTH.flat);
      if (now - lastBoil > 140) { bi = (bi + 1) % 3; face.setAttribute('d', boil[bi]); lastBoil = now; }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }
</script>

<style>
  .home { position: relative; height: max(100svh, 780px); overflow: hidden; }
  .hill { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .intro { position: relative; z-index: 1; padding: clamp(110px, 17vh, 170px) var(--gut) 0 var(--col); max-width: calc(var(--col) + 600px); }
  h1 { font: italic 400 clamp(1.9rem, 2.6vw, 2.2rem)/1.15 var(--serif); color: var(--ink-2); letter-spacing: -0.01em; margin: 0 0 14px; }
  .intro p { margin: 0; }
  .free { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 26px !important; }
  .stamps { display: inline-flex; gap: 8px; }
  .lately { margin-top: 18px !important; }
  .lately a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
  .lately a:hover { text-decoration-color: var(--ink-2); }
  .wonder { margin-top: 26px !important; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .wonder .meta { width: 100%; }
  .q { font: italic 400 21px/1.35 var(--serif); color: var(--ink); }
  .q.in { animation: qin .5s cubic-bezier(.2,.8,.2,1); }
  @keyframes qin { from { opacity: 0; transform: translateY(6px); } }
  .next-q { border: 0; background: none; padding: 0; cursor: pointer; font: 400 12.5px var(--sans); color: var(--ink-3); }
  .next-q:hover { color: var(--ink); }
  .join { margin-top: 30px; display: grid; gap: 10px; max-width: 460px; }
  .join p { font-size: 15.5px; line-height: 1.5; }
  .weather { position: absolute; z-index: 1; right: var(--gut); bottom: 22px; margin: 0; text-align: right; font: 400 13px/1.45 var(--sans); color: #fff; text-shadow: 0 1px 6px rgba(20, 30, 5, .35); display: grid; }
  .weather .dim { opacity: .78; }
  .doodle { position: fixed; left: 0; top: 0; width: 40px; height: 46px; z-index: 30; pointer-events: none; opacity: 0; transition: opacity .3s; will-change: transform; }
  @media (max-width: 700px) {
    .home { height: max(100svh, 1010px); }
    .intro { padding-top: 112px; font-size: 16.5px; }
    .join { margin-top: 22px; }
    .wonder { margin-top: 26px !important; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .wonder .meta { width: 100%; }
  .q { font: italic 400 21px/1.35 var(--serif); color: var(--ink); }
  .q.in { animation: qin .5s cubic-bezier(.2,.8,.2,1); }
  @keyframes qin { from { opacity: 0; transform: translateY(6px); } }
  .next-q { border: 0; background: none; padding: 0; cursor: pointer; font: 400 12.5px var(--sans); color: var(--ink-3); }
  .next-q:hover { color: var(--ink); }
  .join { margin-top: 30px; display: grid; gap: 10px; max-width: 460px; }
  .join p { font-size: 15.5px; line-height: 1.5; }
  .weather { left: var(--gut); bottom: 16px; font-size: 12px; }
  }
</style>
