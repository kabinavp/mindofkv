---
import Base from '../layouts/Base.astro';
import Stamp from '../components/Stamp.astro';
import Subscribe from '../components/Subscribe.astro';
import { SITE } from '../site.config';

const hill = SITE.hill;
---
<Base bare>
  <section class="home">
    <canvas id="hill" class="hill" role="img" aria-label="A grassy hill with a lone tree. KV rides a bike up and down the slope."
      data-lat={hill.lat ?? ''} data-lon={hill.lon ?? ''}></canvas>

    <div class="intro">
      <h1>Hi, I’m KV.</h1>
      <p>I chase ideas, ride hills, read too many books, and make things just to see what happens. This is my notebook, where all of it ends up: models for thinking, essays, books and experiments.</p>
      <p class="free">
        <span>In my free time,</span>
        <span class="stamps">
          <Stamp kind="ride" label="I ride. Toggle the cyclist" pressed />
          <Stamp kind="build" label="I make things. Toggle the maker" />
          <Stamp kind="film" label="I film. Toggle the filmmaker" />
        </span>
      </p>
      <div class="join">
        <p><span class="ink">{SITE.newsletter.club}.</span> Every Sunday: one idea, one question, one book, one line worth keeping.{SITE.newsletter.subscribers && <> Join {SITE.newsletter.subscribers}+ curious readers.</>}</p>
        <Subscribe id="home-email" />
      </div>
    </div>

    <p class="weather" aria-live="polite">
      <span data-w1>Slight breeze on {hill.spot}</span>
      <span data-w2 class="dim">&nbsp;</span>
    </p>

  </section>
</Base>

<script>
  import { Hill, liveWind, describeWind, compass, type Activity } from '../scripts/scene';

  const canvas = document.getElementById('hill') as HTMLCanvasElement;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hill = new Hill(canvas, still);
  const w1 = document.querySelector('[data-w1]')!, w2 = document.querySelector('[data-w2]')!;
  const spot = w1.textContent!.replace(/^Slight breeze on /, '');

  const fmtTime = (tz?: string) => new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: tz });
  const setWeather = (mph: number, deg: number | null, tz?: string, abbr?: string, live = false) => {
    hill.wind.mph = mph;
    if (deg !== null) { const s = -Math.sin((deg * Math.PI) / 180); hill.wind.sign = Math.abs(s) < 0.3 ? Math.sign(s || 1) * 0.3 : s; }
    w1.textContent = `${describeWind(mph)} on ${spot}${live ? ' right now' : ''}`;
    w2.textContent = live
      ? `${fmtTime(tz)} ${abbr ?? ''} · ${Math.round(mph)} mph ${compass(deg ?? 270)} wind`
      : `${fmtTime()} where you are`;
  };
  setWeather(7, 260);
  const lat = parseFloat(canvas.dataset.lat ?? ''), lon = parseFloat(canvas.dataset.lon ?? '');
  if (!Number.isNaN(lat) && !Number.isNaN(lon)) {
    liveWind(lat, lon).then((w) => setWeather(w.mph, w.deg, w.tz, w.abbr, true)).catch(() => {});
  }

  // Run only while visible
  new IntersectionObserver(([e]) => (e.isIntersecting ? hill.start() : hill.stop())).observe(canvas);
  let rt = 0;
  addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => hill.resize(), 120); });
  document.fonts?.ready.then(() => hill.resize());

  // Stamps toggle what KV is doing
  document.querySelectorAll<HTMLButtonElement>('[data-activity]').forEach((b, i) => {
    b.style.setProperty('--r', ['-2deg', '1.5deg', '-1deg'][i]);
    b.addEventListener('click', () => b.setAttribute('aria-pressed', String(hill.toggle(b.dataset.activity as Activity))));
  });


</script>

<style>
  .home { position: relative; height: max(100svh, 780px); overflow: hidden; }
  .hill { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .intro { position: relative; z-index: 1; padding: clamp(110px, 17vh, 170px) var(--gut) 0 var(--col); max-width: calc(var(--col) + 600px); }
  h1 { font: 400 clamp(2.4rem, 3.6vw, 3rem)/1.05 var(--display); color: var(--ink); letter-spacing: -0.03em; margin: 0 0 16px; }
  .intro p { margin: 0; }
  .free { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 26px !important; }
  .stamps { display: inline-flex; gap: 8px; }
  .lately { margin-top: 18px !important; }
  .lately a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
  .lately a:hover { text-decoration-color: var(--ink-2); }
  .join { margin-top: 30px; display: grid; gap: 10px; max-width: 460px; }
  .join p { font-size: 15.5px; line-height: 1.5; }
  .weather { position: absolute; z-index: 1; right: var(--gut); bottom: 22px; margin: 0; text-align: right; font: 400 13px/1.45 var(--sans); color: #fff; text-shadow: 0 1px 6px rgba(20, 30, 5, .35); display: grid; }
  .weather .dim { opacity: .78; }
  @media (max-width: 700px) {
    .home { height: max(100svh, 820px); }
    .intro { padding-top: 112px; font-size: 16.5px; }
    .join { margin-top: 22px; }
    .join { margin-top: 30px; display: grid; gap: 10px; max-width: 460px; }
  .join p { font-size: 15.5px; line-height: 1.5; }
  .weather { left: var(--gut); bottom: 16px; font-size: 12px; }
  }
</style>
