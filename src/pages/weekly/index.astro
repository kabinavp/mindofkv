---
import Base from '../../layouts/Base.astro';
import Subscribe from '../../components/Subscribe.astro';
import Mascot from '../../components/Mascot.astro';
import { SITE } from '../../site.config';

const n = SITE.newsletter;
const jsonld = { '@type': 'CollectionPage', name: `${n.name}: the weekly newsletter`, url: `${SITE.url}/weekly`, description: n.pitch };
---
<Base title={`${n.name}: a 5-minute read every Sunday`} description="Low Gear is a free weekly newsletter on how good decisions get made. Every Sunday: one idea, one question, one book and one line worth keeping. Five minutes to read." image="/og/weekly.png" jsonld={jsonld} signup={false}>
  <div class="page">
    <div class="head">
      <Mascot height={64} />
      <div>
        <p class="meta">Weekly · Every Sunday · 5-minute read</p>
        <h1 class="title">{n.name}</h1>
      </div>
    </div>
    <p class="lede">Low gear is what you shift into for the steepest part of a climb. This is the same for hard calls at work: one idea you can use on Monday, one question to sit with, one book and one line worth keeping. Five minutes, every Sunday.</p>
    <div class="join">
      <p class="ink club">{n.cta}{n.subscribers ? `, with ${n.subscribers}+ readers` : ''}.</p>
      <Subscribe id="weekly-email" />
      <p class="meta">Free. Sent from mindofkv.com. Unsubscribe in one click.</p>
    </div>

  </div>
</Base>
<style>
  .head { display: flex; align-items: flex-end; gap: 16px; }
  .head .title { margin: 4px 0 0; }
  .lede { font-size: 19px; line-height: 1.6; color: var(--ink-2); max-width: 600px; margin-top: 18px !important; }
  .join { max-width: 440px; display: grid; gap: 10px; margin-top: 28px; }
  .club { font: 700 1.05rem var(--sans); }
</style>
