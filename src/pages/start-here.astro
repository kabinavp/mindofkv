---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { getArticles, getVideos } from '../lib/content';
const favs = [
  ...(await getArticles()).filter((a) => a.data.featured).map((e) => ({ title: e.data.title, href: `/articles/${e.id}`, date: e.data.date, kind: 'Essay' })),
  ...(await getVideos()).filter((v) => v.data.featured).map((e) => ({ title: e.data.title, href: `/videos/${e.id}`, date: e.data.date, kind: 'Video' })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---
<Base title="Start here" description="New here? The best places to begin.">
  <div class="page">
    <h1 class="title">Start here</h1>
    <p>Welcome. I’m KV: I build software for a living and products on the side, and this site is where I write, film and ship all of it in public. If you only read a few things, make it these.</p>
    <h2 class="sub-h">Favourites</h2>
    <EntryList rows={favs} />
    <h2 class="sub-h">Then</h2>
    <p class="measure">Follow a <a href="/series" class="u">series</a> from part one, see what I’m <a href="/building" class="u">building</a>, or check what I’m doing <a href="/now" class="u">now</a>. The best way to keep up is the newsletter below.</p>
  </div>
</Base>
