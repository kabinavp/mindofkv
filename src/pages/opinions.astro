---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ModelIcon from '../components/ModelIcon.astro';
import { getModels } from '../lib/content';
import { SITE } from '../site.config';

const opinions = (await getCollection('opinions')).sort((a, b) => a.data.order - b.data.order);
const models = await getModels();
const rows = await Promise.all(opinions.map(async (o) => ({ o, Content: (await render(o)).Content, model: models.find((m) => m.id === o.data.model) })));
const strength = { strong: { dots: 3, label: 'Strongly held' }, leaning: { dots: 2, label: 'Leaning this way' }, exploring: { dots: 1, label: 'Still exploring' } } as const;
const jsonld = { '@type': 'CollectionPage', name: 'Opinions', url: `${SITE.url}/opinions`, description: 'What KV thinks about product, leadership, teams and careers.', hasPart: opinions.map((o) => ({ '@type': 'Claim', text: o.data.stance, author: { '@id': `${SITE.url}/#kv` }, url: `${SITE.url}/opinions#${o.id}` })) };
---
<Base title="Opinions on Product, Leadership and Careers" description="What I think about a few things: short, clear opinions on product, leadership, teams and careers, and how strongly I hold each one." image="/og/opinions.png" jsonld={jsonld}>
  <div class="page">
    <h1 class="title">Opinions</h1>
    <p>What I think about a few things, and how sure I am. Strong opinions, loosely held: when I change my mind, I’ll say so here.</p>
    <ol class="ops">
      {rows.map(({ o, Content, model }) => (
        <li id={o.id}>
          <p class="top">
            <span class="topic">{o.data.topic}</span>
            <span class="str" title={strength[o.data.strength].label}>
              {[1, 2, 3].map((i) => <i class:list={{ on: i <= strength[o.data.strength].dots }}></i>)}
              <span>{strength[o.data.strength].label}</span>
            </span>
          </p>
          <h2 class="stance"><a href={`#${o.id}`}>{o.data.stance}</a></h2>
          <div class="why"><Content /></div>
          <p class="meta foot">
            <span>Held since {o.data.since.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
            {model && <a href={`/models/${model.id}`} class="mlink"><ModelIcon id={model.id} size={20} /><span>{model.data.title}</span></a>}
          </p>
        </li>
      ))}
    </ol>
  </div>
</Base>
<style>
  .ops { list-style: none; margin: 48px 0 0; padding: 0; max-width: 640px; }
  .ops li { padding: 30px 0 32px; border-top: 1px solid var(--line); scroll-margin-top: 24px; }
  .ops li:last-child { border-bottom: 1px solid var(--line); }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .topic { font: 500 11px var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }
  .str { display: inline-flex; align-items: center; gap: 4px; font: 400 11.5px var(--sans); color: var(--ink-3); }
  .str i { width: 6px; height: 6px; border-radius: 50%; background: var(--line); }
  .str i.on { background: var(--accent); }
  .str span { margin-left: 6px; }
  .stance { margin: 10px 0 0; font: italic 400 clamp(1.4rem, 2.2vw, 1.75rem)/1.25 var(--serif); color: var(--ink); text-wrap: balance; }
  .stance a:hover { color: var(--ink-2); }
  .why { margin-top: 10px; color: var(--ink-2); line-height: 1.65; }
  .foot { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 18px; margin-top: 14px !important; }
  .mlink { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); font: 400 13px var(--sans); }
  .mlink:hover span { color: var(--accent); }
</style>
