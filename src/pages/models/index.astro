---
import Base from '../../layouts/Base.astro';
import ModelIcon from '../../components/ModelIcon.astro';
import { getModels } from '../../lib/content';
const models = await getModels();
---
<Base title="Models" description="Thinking tools I keep coming back to, each with the essays where I’ve used it.">
  <div class="page">
    <h1 class="title">Models</h1>
    <p>Thinking tools I keep coming back to. Each one gets a short page explaining the idea, the questions it makes you ask, and the essays where I’ve put it to work.</p>
    <ol class="grid">
      {models.map((m, i) => (
        <li>
          <a href={`/models/${m.id}`} class="card">
            <span class="top"><ModelIcon id={m.id} /><span class="n">No. {String(i + 1).padStart(2, '0')}</span></span>
            <span class="t">{m.data.title}</span>
            <span class="o">{m.data.oneliner}</span>
            <span class="meta">{m.data.essays.length} {m.data.essays.length === 1 ? 'essay' : 'essays'} <span class="go">Read →</span></span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Base>
<style>
  .grid { list-style: none; margin: 48px 0 0; padding: 0; max-width: 920px; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .card { height: 100%; display: flex; flex-direction: column; gap: 6px; padding: 20px 20px 18px; border: 1px solid var(--line); border-radius: 6px; background: var(--paper); transition: border-color .25s, transform .25s, box-shadow .25s; }
  .card:hover { border-color: #cfcfca; transform: translateY(-2px); box-shadow: 0 10px 24px -16px rgba(40, 40, 20, .35); }
  .top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }
  .n { font: 400 11.5px var(--sans); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .t { font: italic 400 1.35rem/1.2 var(--serif); color: var(--ink); }
  .o { color: var(--ink-2); font-size: 15.5px; line-height: 1.5; flex: 1; }
  .card .meta { display: flex; justify-content: space-between; margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--line); }
  .go { color: var(--ink); opacity: 0; transform: translateX(-4px); transition: opacity .25s, transform .25s; }
  .card:hover .go { opacity: 1; transform: none; }
  .card:focus-visible .go { opacity: 1; }
</style>
