---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Subscribe from '../../components/Subscribe.astro';
import { getOpinions } from '../../lib/opinions';
import { fmtDate } from '../../lib/content';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  return (await getOpinions()).filter((o) => o.status === 'published').map((o) => ({ params: { slug: o.id }, props: { o } }));
}
const { o } = Astro.props;
const Content = o.post ? null : (await render(o.entry)).Content;
const url = `${SITE.url}/opinions/${o.id}`;
const minutes = Math.max(1, Math.round(o.words / 230));
const jsonld = [
  { '@type': 'OpinionNewsArticle', headline: o.title, description: o.description, url, image: `${SITE.url}/og/opinions/${o.id}.png`, datePublished: o.date?.toISOString(), author: { '@id': `${SITE.url}/#kv` }, publisher: { '@id': `${SITE.url}/#kv` }, articleSection: o.topic },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Opinions', item: `${SITE.url}/opinions` }, { '@type': 'ListItem', position: 2, name: o.title, item: url }] },
];
---
<Base title={o.title} description={o.description} type="article" image={`/og/opinions/${o.id}.png`} jsonld={jsonld} published={o.date} signup={false}>
  <article class="page">
    <p class="meta"><a href="/opinions" class="u">Opinions</a> · <span class="topic">{o.topic}</span>{o.date && <> · {fmtDate(o.date)}</>} · {minutes} min read</p>
    <h1 class="title" style="margin-top:10px">{o.title}</h1>
    {o.description && <p class="dek">{o.description}</p>}
    <div class="prose" style="margin-top:32px">{Content ? <Content /> : <Fragment set:html={o.post!.html} />}</div>
    <div class="end">
      <p><span class="ink">{SITE.newsletter.club}.</span> Get the next one in your inbox, plus one new idea every Sunday.</p>
      <Subscribe id="op-email" />
    </div>
  </article>
</Base>
<style>
  .topic { color: var(--accent); }
  .dek { font-size: 20px; line-height: 1.5; font-style: italic; color: var(--ink-3); max-width: 600px; }
  .prose :global(figure) { margin: 1.6em 0; } .prose :global(figure img) { width: 100%; height: auto; }
  .end { max-width: 560px; display: grid; gap: 12px; margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--line); }
</style>
