---
import Base from '../../layouts/Base.astro';
import { getOpinions } from '../../lib/opinions';
import { fmtDate } from '../../lib/content';
import { SITE } from '../../site.config';

const all = await getOpinions();
const published = all.filter((o) => o.status === 'published');
const upcoming = all.filter((o) => o.status === 'in-the-works');
const jsonld = { '@type': 'CollectionPage', name: 'Opinions', url: `${SITE.url}/opinions`, hasPart: published.map((o) => ({ '@type': 'OpinionNewsArticle', headline: o.title, url: `${SITE.url}/opinions/${o.id}`, author: { '@id': `${SITE.url}/#kv` } })) };
---
<Base title="Opinions" description="KV’s opinions on bigger questions: education in the age of AI, Indian taxation, technology and society." image="/og/opinions.png" jsonld={jsonld}>
  <div class="page">
    <h1 class="title">Opinions</h1>
    <p>What I think about the bigger questions: education, taxation, technology, and how we live and work. These are my views, argued in full, and I’ll update them when I change my mind.</p>

    {published.length > 0 && (
      <ul class="ops">
        {published.map((o) => (
          <li>
            <a href={`/opinions/${o.id}`}>
              <span class="topic">{o.topic}</span>
              <span class="t">{o.title}</span>
              {o.description && <span class="d">{o.description}</span>}
              <span class="meta">{o.date && fmtDate(o.date)}{o.words > 0 && ` · ${Math.max(1, Math.round(o.words / 230))} min read`}</span>
            </a>
          </li>
        ))}
      </ul>
    )}

    {upcoming.length > 0 && (
      <section>
        <h2 class="sub-h">In the works</h2>
        <ul class="soon">
          {upcoming.map((o) => (
            <li><span class="topic">{o.topic}</span><span class="t">{o.title}</span></li>
          ))}
        </ul>
        <p class="meta note">Want these when they’re out? <a href="/weekly" class="u">Get Low Gear every Sunday</a>.</p>
      </section>
    )}
  </div>
</Base>
<style>
  .ops { list-style: none; margin: 40px 0 0; padding: 0; max-width: 640px; border-top: 1px solid var(--line); }
  .ops a { display: grid; gap: 4px; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .topic { font: 500 11px var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }
  .ops .t { font: 400 clamp(1.5rem, 2.3vw, 1.8rem)/1.15 var(--display); letter-spacing: -0.025em; color: var(--ink); transition: color .2s; }
  .ops a:hover .t { color: var(--ink-2); }
  .d { color: var(--ink-2); line-height: 1.55; }
  .soon { list-style: none; margin: 0; padding: 0; max-width: 640px; display: grid; gap: 14px; }
  .soon li { display: grid; gap: 2px; padding-left: 16px; border-left: 2px solid var(--stamp-edge); }
  .soon .t { font: 400 1.35rem/1.2 var(--display); letter-spacing: -0.02em; color: var(--ink-2); }
  .note { margin-top: 20px !important; }
</style>
