---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import BookCover from '../components/BookCover.astro';
import { getBooks, isbn10 } from '../lib/content';
import { coverFor } from '../lib/covers';
import { SITE } from '../site.config';

const books = await getBooks();
const { domain, tag } = SITE.amazon;
const buy = (b: (typeof books)[number]) => {
  if (b.data.link) return { href: b.data.link, label: new URL(b.data.link).hostname.replace(/^www\./, '') };
  const id = b.data.isbn && isbn10(b.data.isbn);
  const t = tag ? `tag=${encodeURIComponent(tag)}` : '';
  const href = id
    ? `https://www.${domain}/dp/${id}${t ? `?${t}` : ''}`
    : `https://www.${domain}/s?k=${encodeURIComponent(`${b.data.title} ${b.data.author}`)}&i=stripbooks${t ? `&${t}` : ''}`;
  return { href, label: 'Amazon' };
};
const rows = await Promise.all(books.map(async (b) => ({ b, Content: (await render(b)).Content, link: buy(b), cover: await coverFor(b.data) })));
const reading = rows.filter((r) => r.b.data.status === 'reading');
const done = rows.filter((r) => r.b.data.status === 'read');
const next = rows.filter((r) => r.b.data.status === 'next');
const stars = (n?: number) => (n ? '★'.repeat(n) + '☆'.repeat(5 - n) : '');
const rel = tag ? 'sponsored noopener' : 'noopener';
---
<Base title="Books" description="What I’m reading now, what I’ve read, and what’s up next.">
  <div class="page">
    <h1 class="title">Books</h1>
    <p>What I’m reading now, what I’ve read, and what’s up next. Fiction mostly, the kind that stays with you for weeks.</p>

    {[{ label: 'Reading now', list: reading }, { label: 'Read', list: done }].filter((g) => g.list.length).map((g) => (
      <section>
        <h2 class="sub-h">{g.label}</h2>
        <ul class="books">
          {g.list.map(({ b, Content, link, cover }) => (
            <li class="book" id={b.id}>
              <a href={link.href} target="_blank" rel={rel} class="cv" tabindex="-1" aria-hidden="true">
                <BookCover title={b.data.title} author={b.data.author} src={cover} />
              </a>
              <div class="body">
                <h3>{b.data.title}{b.data.status === 'reading' && <span class="chip live">Reading now</span>}{b.data.favourite && <span class="chip fav">Favourite</span>}</h3>
                <p class="by">{b.data.author}{b.data.year && <> · {b.data.year}</>}</p>
                {!b.data.myTake && <p class="lbl">About the book</p>}
                <div class="review"><Content /></div>
                <p class="meta foot">
                  {b.data.rating && <span class="stars" aria-label={`${b.data.rating} out of 5`}>{stars(b.data.rating)}</span>}
                  {b.data.finished && <span>Finished {b.data.finished.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</span>}
                  {!b.data.myTake && <span>My take, coming soon</span>}
                  <a href={link.href} target="_blank" rel={rel} class="u buy">Find it on {link.label} ↗</a>
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
    {next.length > 0 && (
      <section>
        <h2 class="sub-h">Up next</h2>
        <ul class="next">
          {next.map(({ b, link, cover }) => (
            <li id={b.id}>
              <a href={link.href} target="_blank" rel={rel} title={`${b.data.title} by ${b.data.author}`}>
                <BookCover title={b.data.title} author={b.data.author} src={cover} />
                <span class="nt">{b.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    {tag && <p class="meta disclosure">As an Amazon Associate I earn from qualifying purchases. It costs you nothing extra.</p>}
  </div>
</Base>
<style>
  .books { list-style: none; padding: 0; margin: 8px 0 0; max-width: 680px; display: grid; gap: 52px; }
  .book { display: grid; grid-template-columns: 112px 1fr; gap: 28px; align-items: start; }
  .cv { display: block; transition: transform .35s cubic-bezier(.2,.8,.2,1.3); }
  .cv:hover { transform: rotate(-1.5deg) translateY(-3px); }
  h3 { margin: 0; font: italic 400 1.35rem/1.25 var(--serif); color: var(--ink); display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  h3 .chip { font-style: normal; } .fav::before { background: #d9822b; }
  .by { font: 400 13px var(--sans); color: var(--ink-3); margin-top: 3px !important; }
  .lbl { font: 500 10.5px var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); margin-top: 12px !important; }
  .review { margin-top: 6px; color: #47463f; }
  .lbl + .review { color: var(--ink-2); }
  .review :global(p + p) { margin-top: .8em; }
  .foot { display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: baseline; margin-top: 12px !important; }
  .stars { color: #b58a2a; letter-spacing: 1px; }
  .buy { font: 500 12.5px var(--sans); }
  .next { list-style: none; padding: 0; margin: 8px 0 0; max-width: 680px; display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 28px 22px; }
  .next a { display: grid; gap: 10px; }
  .next a :global(.cover) { transition: transform .35s cubic-bezier(.2,.8,.2,1.3); }
  .next a:hover :global(.cover) { transform: rotate(-1.5deg) translateY(-3px); }
  .nt { font: italic 400 15px/1.3 var(--serif); color: var(--ink); }
  .disclosure { margin-top: 64px !important; max-width: 600px; }
  @media (max-width: 560px) { .book { grid-template-columns: 84px 1fr; gap: 18px; } }
</style>
