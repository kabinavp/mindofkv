---
import Base from '../layouts/Base.astro';
import { getProducts } from '../lib/content';
const products = await getProducts();
const label = { live: 'Live', building: 'In progress', idea: 'Idea', retired: 'Retired' } as const;
---
<Base title="Projects" description="Things I’ve made, am making, or want to make.">
  <div class="page">
    <h1 class="title">Projects</h1>
    <p>Things I’ve made, am making, or want to make. Some worked and some didn’t. Every one of them started with “I wonder if…”.</p>
    <ul class="ps">
      {products.map((p) => (
        <li>
          <div class="head">
            <h2>{p.data.url ? <a href={p.data.url} class="u" target="_blank" rel="noopener">{p.data.title}</a> : p.data.title}</h2>
            <span class:list={['chip', p.data.status]}>{label[p.data.status]}</span>
          </div>
          <p>{p.data.tagline}</p>
          <p class="meta">
            {p.data.metric && <span class="ink">{p.data.metric} {p.data.metricLabel}</span>}
            {p.data.metric && ' · '}since {p.data.started.getFullYear()}{p.data.stack.length > 0 && ` · ${p.data.stack.join(', ')}`}
          </p>
        </li>
      ))}
    </ul>
  </div>
</Base>
<style>
  .ps { list-style: none; padding: 0; margin: 48px 0 0; max-width: 600px; display: grid; gap: 34px; }
  .head { display: flex; align-items: center; gap: 12px; }
  h2 { margin: 0; font: 400 1.45rem/1.2 var(--display); letter-spacing: -0.02em; color: var(--ink); }
  .meta { margin-top: 4px !important; } .meta .ink { font-weight: 500; }
</style>
